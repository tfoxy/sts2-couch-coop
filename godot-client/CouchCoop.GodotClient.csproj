<Project Sdk="Godot.NET.Sdk/4.5.1">

  <!--
    CouchCoop native Godot client.

    Godot.NET.Sdk/4.5.1 is the EXACT pin (the game runs Godot 4.5.1, so the client pins 4.5.1).
    Verified to restore from NuGet (present in ~/.nuget/packages/godot.net.sdk/4.5.1). If a future
    environment cannot restore 4.5.1, the nearest 4.5.x is the acceptable fallback — NOTE it here.

    ZERO game/spirectl references by design: this project consumes the mod's mirror WebSocket + HTTP
    asset stream only. It never links SlayTheSpire2 / GodotSharp-game / spirectl assemblies.

    The empty Directory.Build.props + Directory.Build.targets next to this file are LOAD-BEARING:
    MSBuild walks up the tree for the NEAREST Directory.Build.* and stops there, so they shield this
    project from the repo root's Sts2AssembliesDir machinery. Do not delete them.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CouchCoop.GodotClient</RootNamespace>
    <!-- Godot loads the game assembly dynamically; keep the default-on setting explicit. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The shared, game-free/Godot-free protocol layer (SceneModel reader/applier + envelopes + send
      records). It opts out of the root Sts2AssembliesDir machinery (CouchCoopRequiresSts2Assemblies
      false in its own csproj) so it builds on clean CI runners with no game assemblies. The real
      client stack (Net/Scene/App) consumes it.
      This reference must survive Android export (README payload check: CouchCoop.MirrorProtocol.dll
      lands in assets/.godot/mono/publish/arm64/).
    -->
    <ProjectReference Include="../src/CouchCoop.MirrorProtocol/CouchCoop.MirrorProtocol.csproj" />
  </ItemGroup>

</Project>
