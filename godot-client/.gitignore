# Godot editor cache / generated import data.
.godot/
.mono/            # legacy 3.x / early-4.x Mono glue dir (kept out of the tree if a tool regenerates it)

# .NET build output.
bin/
obj/

# Export / packaging output.
dist/
*.apk
*.aab
*.pck

# Android gradle custom-build generated bits (the res://android/build template is generated by the
# editor's "Install Android Build Template"; keep the generated gradle output out of git).
android/build/
android/.gradle/
android/.buildozer/

# Godot .NET crash dumps.
mono_crash.*

# Local, machine-specific export overrides (never commit signing configs / local paths).
export_presets.local.cfg
android/.build_version

# godot-qa dev-only addon (symlink to ../godot-qa; never ship/commit)
addons/godot_qa
.qa/
