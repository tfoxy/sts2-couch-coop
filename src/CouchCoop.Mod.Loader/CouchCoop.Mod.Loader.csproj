<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AssemblyName>couchcoop</AssemblyName>
    <RootNamespace>CouchCoop.Mod.Loader</RootNamespace>
    <LangVersion>latest</LangVersion>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <!-- The linked CouchCoopLogLine.cs below also exists in the referenced CouchCoop.Mod. Same situation, and
         same suppression, as CouchCoop.Mod.HotReload's linked Server/ sources: the locally compiled copy
         wins, which is exactly what is wanted here. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <OutputPath Condition="'$(CouchCoopBuildToLocalMods)' == 'true' and '$(CouchCoopLocalModDir)' != ''">$(CouchCoopLocalModDir)/</OutputPath>
    <PublishDir Condition="'$(CouchCoopBuildToLocalMods)' == 'true' and '$(CouchCoopLocalModDir)' != ''">$(CouchCoopLocalModDir)/</PublishDir>
    <AppendTargetFrameworkToOutputPath Condition="'$(CouchCoopBuildToLocalMods)' == 'true' and '$(CouchCoopLocalModDir)' != ''">false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath Condition="'$(CouchCoopBuildToLocalMods)' == 'true' and '$(CouchCoopLocalModDir)' != ''">false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2AssembliesDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2AssembliesDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CouchCoop.Mod/CouchCoop.Mod.csproj" />
    <ProjectReference Include="../CouchCoop.Mod.Contracts/CouchCoop.Mod.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      This is an explicitly bundled shared-payload file, not a compile reference. Sentry requires
      version 10, but some newer SDKs prefer net9.0's version 9 framework reference and omit the
      package DLL from publish output. Excluding automatic assets and copying the reviewed package
      file directly makes release contents independent of ResolveAssemblyReference heuristics.
    -->
    <PackageReference
      Include="System.Diagnostics.DiagnosticSource"
      Version="[10.0.10]"
      GeneratePathProperty="true"
      PrivateAssets="all"
      ExcludeAssets="all" />
    <None
      Include="$(PkgSystem_Diagnostics_DiagnosticSource)/lib/net9.0/System.Diagnostics.DiagnosticSource.dll"
      Link="System.Diagnostics.DiagnosticSource.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateBundledDiagnosticSource" BeforeTargets="Build">
    <Error
      Condition="!Exists('$(PkgSystem_Diagnostics_DiagnosticSource)/lib/net9.0/System.Diagnostics.DiagnosticSource.dll')"
      Text="Pinned System.Diagnostics.DiagnosticSource 10.0.10 package is missing its net9.0 assembly." />
  </Target>

  <ItemGroup>
    <!-- The prefix every CouchCoop log line carries is written down in exactly one file, and the loader logs
         too. It is LINKED rather than called through the ProjectReference above because the loader has to be
         able to log BEFORE it has installed the assembly resolver that can find CouchCoop.Mod.dll: a lane
         payload keeps the implementation under lanes/<version>/, off every default probing path, so a call
         into that assembly would fail to bind on exactly the paths (lane refusal, bootstrap failure) whose
         only job is to say why the mod did not load. The file is kept free of any reference outside itself
         so that it can be compiled here; the engine latch lives on CouchCoopLog, which is not linked. -->
    <Compile Include="../CouchCoop.Mod/Session/CouchCoopLogLine.cs" Link="Session/CouchCoopLogLine.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="couchcoop.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(CouchCoopEnableHotReload)' != 'true'">
    <Compile Remove="CouchCoopHotReloadProtocol.cs" />
    <Compile Remove="CouchCoopModEntry.HotReload.cs" />
  </ItemGroup>
</Project>
