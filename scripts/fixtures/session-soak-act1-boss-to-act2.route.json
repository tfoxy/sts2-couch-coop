{
  "schema": "couchcoop-session-route/1",
  "name": "act1-boss-to-act2",
  "description": "Worked example for scripts/run-session-soak.mjs: three normal fights, the Act 1 boss, the act transition, the first normal fight of Act 2. `room` rather than `fight` so every peer draws the same encounter; `room`/`act` only outside combat or after `win`. /perf snapshots at each room entry separate first-sight bake spikes from drift. Tune dwellSeconds per session; the step order is the part that keeps a hosted run consistent.",
  "steps": [
    { "kind": "mark", "label": "embarked" },
    { "kind": "wait", "label": "opening-dwell", "dwellSeconds": 240 },

    { "kind": "dev-console", "label": "fight-1", "args": ["room", "MONSTER"] },
    { "kind": "fetch", "label": "fight-1-spine", "args": { "path": "/perf/spine.json" } },
    { "kind": "fetch", "label": "fight-1-bg", "args": { "path": "/perf/bg.json" }, "dwellSeconds": 240 },
    { "kind": "dev-console", "label": "fight-1-win", "args": ["win"], "dwellSeconds": 20 },

    { "kind": "dev-console", "label": "fight-2", "args": ["room", "MONSTER"] },
    { "kind": "fetch", "label": "fight-2-spine", "args": { "path": "/perf/spine.json" } },
    { "kind": "fetch", "label": "fight-2-bg", "args": { "path": "/perf/bg.json" }, "dwellSeconds": 240 },
    { "kind": "dev-console", "label": "fight-2-win", "args": ["win"], "dwellSeconds": 20 },

    { "kind": "dev-console", "label": "fight-3", "args": ["room", "MONSTER"] },
    { "kind": "fetch", "label": "fight-3-spine", "args": { "path": "/perf/spine.json" } },
    { "kind": "fetch", "label": "fight-3-bg", "args": { "path": "/perf/bg.json" }, "dwellSeconds": 240 },
    { "kind": "dev-console", "label": "fight-3-win", "args": ["win"], "dwellSeconds": 20 },

    { "kind": "dev-console", "label": "boss", "args": ["room", "BOSS"] },
    { "kind": "fetch", "label": "boss-spine", "args": { "path": "/perf/spine.json" } },
    { "kind": "fetch", "label": "boss-bg", "args": { "path": "/perf/bg.json" }, "dwellSeconds": 480 },
    { "kind": "dev-console", "label": "boss-win", "args": ["win"], "dwellSeconds": 20 },

    { "kind": "dev-console", "label": "act-2", "args": ["act", "2"], "dwellSeconds": 30 },
    { "kind": "mark", "label": "act-2-entered" },

    { "kind": "dev-console", "label": "act2-fight-1", "args": ["room", "MONSTER"] },
    { "kind": "fetch", "label": "act2-fight-1-spine", "args": { "path": "/perf/spine.json" } },
    { "kind": "fetch", "label": "act2-fight-1-bg", "args": { "path": "/perf/bg.json" }, "dwellSeconds": 240 },
    { "kind": "mark", "label": "route-end" }
  ]
}
