#!/usr/bin/env bash
# Launch DeepSeek Harness for this checkout with the generated repo-scoped overlay.
#
#   scripts/dsh web                 the web profile (the browser UI)
#   scripts/dsh web --port 8080
#   scripts/dsh --dump-config       compose the overlay without starting the app
#
# The overlay is .dsh/profile.patch.yml, generated by scripts/install-agent-config.sh
# from agents/*.md and the same MCP definitions Claude Code uses. It adds the named
# role presets behind the `subagent_role` tool and the mcp__* tools. Because it is a
# --patch overlay, it applies to this checkout only; a worktree gets its own copy.
#
# The web profile is fixed: the role presets and the host delegation tool depend on the
# web bundle's agent-preset registry. Use plain `dsh` for the headless/sdk/acp profiles.
#
# Environment:
#   DSH_BIN   dsh executable (default: dsh on PATH)
#
# Self-test: scripts/test-install-agent-config.sh

set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PATCH="$ROOT/.dsh/profile.patch.yml"

case "${1:-}" in
  -h|--help-launcher)
    sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

# `dsh web` is the canonical spelling; accept it after already selecting the profile.
if [ "${1:-}" = "web" ]; then shift; fi
case "${1:-}" in
  ""|-*|--*) ;;
  *)
    echo "error: scripts/dsh serves the web profile; drop '$1' or use plain dsh" >&2
    exit 1 ;;
esac

if [ ! -f "$PATCH" ]; then
  echo "error: $PATCH is missing — run scripts/install-agent-config.sh first" >&2
  exit 1
fi
if ! command -v "${DSH_BIN:-dsh}" >/dev/null 2>&1; then
  echo "error: DeepSeek Harness (\`${DSH_BIN:-dsh}\`) is not on PATH; install it or set DSH_BIN" >&2
  exit 1
fi

# The role definitions and AGENTS.md assume the repo root. Existing processes and
# sessions keep their own directories, so this only fixes the process's start point.
cd "$ROOT"
exec "${DSH_BIN:-dsh}" --profile web --patch "$PATCH" "$@"
