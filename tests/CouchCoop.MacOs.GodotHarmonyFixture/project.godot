; Synthetic, stock-Godot fixture for the reusable lobby node mount hook. No game content is used.
config_version=5

[application]

config/name="CouchCoop Godot Harmony Fixture"
run/main_scene="res://FixtureRoot.tscn"
config/features=PackedStringArray("4.5", "C#")

[display]

window/size/viewport_width=320
window/size/viewport_height=180

[rendering]

renderer/rendering_method="gl_compatibility"
