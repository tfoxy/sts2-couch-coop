<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CouchCoop.Mod/CouchCoop.Mod.csproj" />
    <!-- DisableTransitiveProjectReferences hides the mod's MirrorProtocol reference from this compiler; the M3
         WS-T host-discovery responder mount below names HostDiscoveryReply directly, so reference it here (same
         pattern CouchCoop.Mod.Tests uses). -->
    <ProjectReference Include="../../src/CouchCoop.MirrorProtocol/CouchCoop.MirrorProtocol.csproj" />
    <!-- The browser server's public constructor exposes NetworkAdmissionLimiter. With transitive project
         references disabled, this must be a direct reference for the harness to compile. -->
    <ProjectReference Include="../../src/CouchCoop.Mod.Contracts/CouchCoop.Mod.Contracts.csproj" />
    <!-- FakeSpirectlRuntime implements ISpirectlRuntime directly. CouchCoop.Mod produces the shared
         runtime as CouchCoop.Spirectl.dll; reference that output instead of rebuilding the spirectl
         project with a competing assembly name. -->
    <Reference Include="CouchCoop.Spirectl">
      <HintPath>../../src/CouchCoop.Mod/bin/$(Configuration)/net9.0/CouchCoop.Spirectl.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
