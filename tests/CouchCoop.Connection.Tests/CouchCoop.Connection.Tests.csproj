<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RollForward>Major</RollForward>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CouchCoop.Mod/CouchCoop.Mod.csproj" />
    <ProjectReference Include="../../src/CouchCoop.Mod.Contracts/CouchCoop.Mod.Contracts.csproj" />
    <!-- Direct reference to the shared protocol lib, exactly as CouchCoop.Mod.Tests takes it: with
         DisableTransitiveProjectReferences=true above, the mod's own reference is not flowed to the compiler, and
         the browser DTOs the join-progress test asserts on (BrowserJoinProgressEnvelope) live there. -->
    <ProjectReference Include="../../src/CouchCoop.MirrorProtocol/CouchCoop.MirrorProtocol.csproj" />
    <Reference Include="CouchCoop.Spirectl">
      <HintPath>../../src/CouchCoop.Mod/bin/$(Configuration)/net9.0/CouchCoop.Spirectl.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(Sts2AssembliesDir)/sts2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2AssembliesDir)/GodotSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2AssembliesDir)/0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../CouchCoop.Mod.Tests/WebSocketJoinLifecycleTests.cs" Link="WebSocketJoinLifecycleTests.cs" />
    <Compile Include="../CouchCoop.Mod.Tests/JoinProgressTickerTests.cs" Link="JoinProgressTickerTests.cs" />
    <Compile Include="../CouchCoop.Mod.Tests/ConnectionRegistryTests.cs" Link="ConnectionRegistryTests.cs" />
    <Compile Include="../CouchCoop.Mod.Tests/HostPatchHealthTests.cs" Link="HostPatchHealthTests.cs" />
