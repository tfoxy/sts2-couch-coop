<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RollForward>Major</RollForward>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CouchCoop.Mod/CouchCoop.Mod.csproj" />
    <ProjectReference Include="../../src/CouchCoop.Mod.Contracts/CouchCoop.Mod.Contracts.csproj" />
    <!-- Direct reference to the shared protocol lib: DisableTransitiveProjectReferences=true above means the
         mod's transitive reference isn't flowed to the compiler, and the moved browser DTOs live here. -->
    <ProjectReference Include="../../src/CouchCoop.MirrorProtocol/CouchCoop.MirrorProtocol.csproj" />
    <!-- HotReloadInteropTests exercises the concrete reflection control, which now lives in the bridge assembly
         rather than the game-runtime assembly referenced below. Alias the canonical bridge pair so it cannot
         collide with CouchCoop's deliberately private CouchCoop.Spirectl copy. -->
    <ProjectReference Include="../../../spirectl/bridge-mod/src/Spirectl.BridgeMod/Spirectl.BridgeMod.csproj" Aliases="bridge" />
    <ProjectReference Include="../../../spirectl/bridge-mod/src/Spirectl.Sts2/Spirectl.Sts2.csproj" Aliases="bridgecore" />
    <ProjectReference
      Include="../../src/CouchCoop.Mod.HotReload/CouchCoop.Mod.HotReload.csproj"
      ReferenceOutputAssembly="false"
      OutputItemType="Content"
      CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/CouchCoop.Mod.Loader/CouchCoop.Mod.Loader.csproj" />
    <!-- Tests use bridge types (ISpirectlRuntime, CombatWatchEvent, ...) directly. CouchCoop.Mod produces
         the shared runtime as CouchCoop.Spirectl.dll; reference that output instead of rebuilding the
         spirectl project with a competing assembly name. -->
    <Reference Include="CouchCoop.Spirectl">
      <HintPath>../../src/CouchCoop.Mod/bin/$(Configuration)/net9.0/CouchCoop.Spirectl.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- HeadlessAudioMuteTargetsTests reflects over NAudioManager / NRunMusicController (in sts2.dll, base type
         from GodotSharp.dll) via HarmonyLib.AccessTools (0Harmony.dll). These are Private=false in CouchCoop.Mod,
         so copy them into the test output so the reflection resolves at runtime. Pure metadata reflection — no
         native Godot library is loaded. -->
    <Reference Include="sts2">
      <HintPath>$(Sts2AssembliesDir)/sts2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2AssembliesDir)/GodotSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2AssembliesDir)/0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!--
      RUNTIME closure for the reflection above, not a compile reference: game v0.111.0's sts2.dll carries a
      [ModuleInitializer], so the CLR runs Sentry's Godot auto-init the first time any test touches a game type,
      and without these two assemblies LOADABLE beside it that is a FileNotFoundException that fails every
      patch-target leg before it asserts anything. The auto-init itself is a no-op here — it looks for the Sentry
      GDExtension, which a bare test process does not have, prints one line and returns.

      `Reference Private=true` and NOT `None CopyToOutputDirectory`, which is what this was and why it did not
      work: a copied file lands in the output directory but NOT in CouchCoop.Mod.Tests.deps.json, and a
      framework-dependent app builds its assembly list from that file alone — so the runtime never sees the copy,
      however many times it is made. MEASURED on v0.111.0: with the `None` spelling, the `beta-targets` verb failed
      3 of its 4 legs with "Could not load file or assembly 'Sentry.Godot'" while Sentry.Godot.dll sat beside the
      binary; deleting deps.json (which sends the host back to probing the app directory) made that same build
      pass. Referencing them puts them in deps.json, which is the thing that was actually missing.
      (XML comments cannot carry a double hyphen, so the verb is named without its flag dashes above.)

      Conditional rather than unconditional: v0.107.1 ships neither Sentry.Godot.dll nor a module initializer that
      wants it. Nothing compiles against a Sentry type, so the release payload is unaffected either way.
    -->
    <Reference
      Include="Sentry"
      Condition="'$(Sts2AssembliesDir)' != '' and Exists('$(Sts2AssembliesDir)/Sentry.Godot.dll')">
      <HintPath>$(Sts2AssembliesDir)/Sentry.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference
      Include="Sentry.Godot"
      Condition="'$(Sts2AssembliesDir)' != '' and Exists('$(Sts2AssembliesDir)/Sentry.Godot.dll')">
      <HintPath>$(Sts2AssembliesDir)/Sentry.Godot.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
