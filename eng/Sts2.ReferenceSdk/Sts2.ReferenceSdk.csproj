<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>CouchCoop.Sts2.ReferenceSdk</AssemblyName>
    <RootNamespace>CouchCoop.Sts2.ReferenceSdk</RootNamespace>
    <CouchCoopRequiresSts2Assemblies>false</CouchCoopRequiresSts2Assemblies>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Both packages are build inputs only. ExcludeAssets prevents NuGet from
      importing targets, analyzers, content, or runtime assets into this
      project; the target below copies a reviewed assembly allowlist into a
      temporary compile SDK used by the release build.
    -->
    <PackageReference
      Include="FuYnAloft.Sts2.References"
      Version="[0.107.0-beta]"
      GeneratePathProperty="true"
      PrivateAssets="all"
      ExcludeAssets="all" />
    <PackageReference
      Include="GodotSharp"
      Version="[4.5.1]"
      GeneratePathProperty="true"
      PrivateAssets="all"
      ExcludeAssets="all" />
  </ItemGroup>

  <Target Name="StageSts2ReferenceSdk" AfterTargets="Build">
    <ItemGroup>
      <Sts2ReferenceSdkFile Include="$(PkgFuYnAloft_Sts2_References)/lib/net9.0/sts2.dll" />
      <Sts2ReferenceSdkFile Include="$(PkgFuYnAloft_Sts2_References)/lib/net9.0/0Harmony.dll" />
      <Sts2ReferenceSdkFile Include="$(PkgFuYnAloft_Sts2_References)/lib/net9.0/MonoMod.Backports.dll" />
      <Sts2ReferenceSdkFile Include="$(PkgFuYnAloft_Sts2_References)/lib/net9.0/MonoMod.ILHelpers.dll" />
      <Sts2ReferenceSdkFile Include="$(PkgFuYnAloft_Sts2_References)/lib/net9.0/Sentry.dll" />
      <Sts2ReferenceSdkFile Include="$(PkgFuYnAloft_Sts2_References)/lib/net9.0/SmartFormat.dll" />
      <Sts2ReferenceSdkFile Include="$(PkgFuYnAloft_Sts2_References)/lib/net9.0/SmartFormat.ZString.dll" />
      <Sts2ReferenceSdkFile Include="$(PkgFuYnAloft_Sts2_References)/lib/net9.0/Steamworks.NET.dll" />
      <Sts2ReferenceSdkFile Include="$(PkgGodotSharp)/lib/net8.0/GodotSharp.dll" />
    </ItemGroup>

    <Error
      Condition="!Exists('%(Sts2ReferenceSdkFile.Identity)')"
      Text="Pinned STS2 reference package is missing reviewed compile input: %(Sts2ReferenceSdkFile.Identity)" />
    <Copy
      SourceFiles="@(Sts2ReferenceSdkFile)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
